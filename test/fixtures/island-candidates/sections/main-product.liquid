<div class="product" data-section-type="main-product">
  {%- assign v = product.selected_or_first_available_variant -%}
  <span class="price">{{ v.price | money }}</span>
  {% if v.available %}<button>Add</button>{% else %}<button disabled>Sold out</button>{% endif %}
  {% render 'price-badge', section: section %}
  {% render 'stock-note' %}
</div>
{% schema %}{"name":"Main product"}{% endschema %}
